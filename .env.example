# Non-secret outputs from the Entra External ID bootstrap. Do not put Apple
# private keys, client secrets, access tokens, or authorization codes here.
SOFFORT_ENVIRONMENT=development
SOFFORT_ENTRA_ISSUER=https://REPLACE.ciamlogin.com/00000000-0000-0000-0000-000000000000/v2.0
SOFFORT_ENTRA_JWKS_URL=https://REPLACE.ciamlogin.com/00000000-0000-0000-0000-000000000000/discovery/v2.0/keys
SOFFORT_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
SOFFORT_ENTRA_API_AUDIENCE=00000000-0000-0000-0000-000000000000
SOFFORT_ENTRA_VSCODE_CLIENT_ID=00000000-0000-0000-0000-000000000000
SOFFORT_REQUIRED_SCOPE_VALUE=soffortbackend.access
SOFFORT_REQUIRED_SCOPE_URI=https://soffort.com/mcp/soffortbackend.access
SOFFORT_ALLOWED_HOSTS_CSV=soffort.com
SOFFORT_ALLOWED_ORIGINS_CSV=https://vscode.dev
SOFFORT_LOG_LEVEL=INFO

